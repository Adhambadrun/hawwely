# ============================================================
# HAWWELY — Environment Variables
# Copy this file to .env.local and fill in the values.
# The app runs fully in DEMO mode (bundled seed data) when the
# Supabase variables are missing, so you can develop without them.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Exchange Rate APIs (any one is enough; all optional)
EXCHANGE_RATE_API_KEY=
FREE_CURRENCY_API_KEY=
OPEN_EXCHANGE_RATES_KEY=

# Analytics (optional)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_URL=

# Affiliate IDs (optional — used to build tracked outbound links)
WISE_AFFILIATE_ID=
REMITLY_AFFILIATE_ID=
PAYSEND_AFFILIATE_ID=
WORLDREMIT_AFFILIATE_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Hawwely
NEXT_PUBLIC_WHATSAPP_NUMBER=
CRON_SECRET=change-me-to-a-long-random-string
