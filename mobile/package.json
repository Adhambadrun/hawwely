{
  "name": "hawwely-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "HAWWELY (حوّلي) mobile app — compare money-transfer rates to Egypt.",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "assets": "node scripts/generate-assets.js",
    "sync:shared": "node scripts/sync-shared.js",
    "export:android": "expo export --platform android",
    "build:android": "eas build --platform android --profile production",
    "build:preview": "eas build --platform android --profile preview",
    "submit:android": "eas submit --platform android"
  },
