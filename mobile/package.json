    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "expo-updates": "~0.27.5",
    "expo-web-browser": "~14.0.2",
    "i18next": "^23.16.8",
    "lucide-react-native": "^0.468.0",
    "moti": "^0.30.0",
    "nativewind": "4.1.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^15.4.1",
