    "@react-native-community/netinfo": "11.4.1",
    "@shopify/flash-list": "1.7.3",
    "@supabase/supabase-js": "^2.115.0",
    "expo": "~52.0.49",
    "expo-application": "~6.0.2",
    "expo-asset": "~11.0.5",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-device": "~7.0.3",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image": "~2.0.7",
    "expo-linear-gradient": "~14.0.2",
